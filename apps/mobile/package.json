{
  "name": "@ebio/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --dev-client",
    "dev:client": "APP_VARIANT=client EXPO_PUBLIC_APP_VARIANT=client expo start --dev-client",
    "dev:supplier": "APP_VARIANT=supplier EXPO_PUBLIC_APP_VARIANT=supplier expo start --dev-client",
    "dev:courier": "APP_VARIANT=courier EXPO_PUBLIC_APP_VARIANT=courier expo start --dev-client",
    "dev:device": "bash scripts/dev-device.sh",
    "build:client": "eas build --platform android --profile production-client",
    "build:supplier": "eas build --platform android --profile production-supplier",
    "build:courier": "eas build --platform android --profile production-courier",
    "submit:client": "eas submit --platform android --profile production-client",
    "submit:supplier": "eas submit --platform android --profile production-supplier",
    "submit:courier": "eas submit --platform android --profile production-courier",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.6",
    "@casl/ability": "^6.8.0",
    "@expo-google-fonts/dm-serif-display": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "babel-preset-expo": "~54.0.10",
    "better-auth": "^1.5.6",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "^1.20.1",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
