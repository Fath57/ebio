<!--
  Heading partial
  Variables: text, level? (1 | 2 | 3)
-->
<% const sizes = { 1: '28px', 2: '22px', 3: '18px' } %>
<% const lvl = level || 1 %>
<h<%= lvl %> style="font-family: 'DM Serif Display', Georgia, serif; font-size: <%= sizes[lvl] %>; color: #2A2924; margin: 0 0 16px 0; line-height: 1.3;">
  <%= text %>
</h<%= lvl %>>
