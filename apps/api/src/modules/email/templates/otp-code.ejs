<%- include('partials/heading', { text: 'Votre code de vérification', level: 1 }) %>

<p>Bonjour<% if (userName) { %> <strong><%= userName %></strong><% } %>,</p>

<p>Voici votre code de vérification :</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0;">
  <tr>
    <td align="center" style="background-color: #EDFAF2; border-radius: 10px; padding: 20px 40px;">
      <span style="font-family: 'JetBrains Mono', 'Courier New', monospace; font-size: 32px; font-weight: 700; color: #1A8757; letter-spacing: 8px;">
        <%= otpCode %>
      </span>
    </td>
  </tr>
</table>

<p style="font-size: 13px; color: #9B9890;">
  Ce code expire dans <%= expiresInMinutes %> minutes. Ne le partagez avec personne.
</p>
